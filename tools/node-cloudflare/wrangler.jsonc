{
  "name": "javelin-node",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  // Builds the Rust node core to wasm and its wasm-bindgen glue into build/.
  "build": { "command": "bun run build" },
  "durable_objects": {
    "bindings": [{ "name": "REPOSITORY_NODE", "class_name": "RepositoryNode" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RepositoryNode"] }]
}
